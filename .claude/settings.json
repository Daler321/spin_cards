{
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)",
      "Read(./**/coverage/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/.vite/**)",
      "Read(./**/*.log)",
      "Read(./**/__snapshots__/**)",
      "Read(./pnpm-lock.yaml)",
      "Read(./**/prisma/migrations/**)",
      "Read(./**/generated/**)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/playwright-report/**)",
      "Read(./**/*.tsbuildinfo)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/filter-test-output.sh"
          }
        ]
      }
    ]
  }
}
