# Runtime
NODE_ENV=development
API_PORT=3000
WORKER_HEALTH_PORT=3001
LOG_LEVEL=info

# DATABASE_URL and REDIS_URL are provided by docker compose (infra/docker-compose.yml).

# Comma-separated list of allowed browser origins (Mini App and admin)
CORS_ORIGINS=http://localhost:8080

# Mock Telegram user without initData signature (POST /v1/auth/dev).
# Allowed only with NODE_ENV=development; the API refuses to start otherwise.
DEV_AUTH_BYPASS=false

# Same token as in apps/bot/.env: verifies Telegram initData signatures. Required in production.
TELEGRAM_BOT_TOKEN=
INIT_DATA_MAX_AGE_SEC=86400

# HS256 secret for access tokens, at least 32 characters. `make env` generates one.
JWT_SECRET=__generate__
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_DAYS=30

# Requests per minute (per user, or per IP on public routes)
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_MUTATION_PER_MIN=60
RATE_LIMIT_INTERNAL_PER_MIN=6000

# INTERNAL_API_TOKEN (bot -> api) is generated in infra/.env and passed in by compose.

# Optional owner admin account created by the seed; TOTP is set up on the first login.
ADMIN_OWNER_LOGIN=
ADMIN_OWNER_PASSWORD=
# Encrypts admin TOTP secrets in the database. `make env` generates it; keep it stable.
ADMIN_SECRET_KEY=__generate__
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_IDLE_MIN=60
