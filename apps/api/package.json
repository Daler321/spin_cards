{
  "name": "@spincards/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "node --watch --conditions=@spincards/source --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --watch --conditions=@spincards/source --import @swc-node/register/esm-register src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "prisma migrate deploy",
    "seed": "node --conditions=@spincards/source --import @swc-node/register/esm-register src/seed/main.ts",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "seed:prod": "node dist/seed/main.js",
    "ops": "node --conditions=@spincards/source --import @swc-node/register/esm-register src/ops/cli.ts",
    "ledger:verify": "node --conditions=@spincards/source --import @swc-node/register/esm-register src/ledger/verify-cli.ts",
    "config:defaults": "node --conditions=@spincards/source --import @swc-node/register/esm-register src/seed/config-defaults-cli.ts",
    "stats": "node --conditions=@spincards/source --import @swc-node/register/esm-register src/analytics/stats-cli.ts",
    "broadcast": "node --conditions=@spincards/source --import @swc-node/register/esm-register src/notifications/broadcast-cli.ts",
    "load:spin": "node --conditions=@spincards/source --import @swc-node/register/esm-register scripts/load-spin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@spincards/game-core": "workspace:*",
    "@spincards/shared": "workspace:*",
    "bullmq": "^6.3.13",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0"
  }
}
