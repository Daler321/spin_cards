NODE_ENV=development
LOG_LEVEL=info
BOT_HEALTH_PORT=3002

# Token from @BotFather. Leave empty to start the bot in idle mode (no Telegram connection).
BOT_TOKEN=

# PUBLIC_URL (HTTPS address of the Mini App) and INTERNAL_API_TOKEN are set once in infra/.env
# and passed in by compose.

# polling (dev) or webhook (prod: Telegram calls PUBLIC_URL/bot/webhook through the proxy)
BOT_MODE=polling

# false: commands work, notifications are not delivered (they wait in the outbox)
NOTIFY_ENABLED=true
# Deliver only these kinds (comma-separated: broadcast, free_spin_ready, card_expiring,
# referral_reward, comeback); empty = all
NOTIFY_KINDS=
BOT_WEBHOOK_SECRET=__generate__
