# Production settings. `./spincards.sh init <domain>` copies this to .env and generates the
# secrets; fill in the rest by hand. Never commit .env or paste it anywhere.

# Domain of the Mini App (A record -> this server). Caddy gets the HTTPS certificate itself.
# The admin panel lives at https://<domain>/admin/
DOMAIN=

# Token from @BotFather (used by the bot and by the api to verify initData).
TELEGRAM_BOT_TOKEN=

# First owner account of the admin panel (TOTP is set up on the first login).
# Remove the password from this file after the first start.
ADMIN_OWNER_LOGIN=owner
ADMIN_OWNER_PASSWORD=

POSTGRES_USER=spincards
POSTGRES_DB=spincards
POSTGRES_PASSWORD=__generate__

JWT_SECRET=__generate__
ADMIN_SECRET_KEY=__generate__
INTERNAL_API_TOKEN=__generate__
BOT_WEBHOOK_SECRET=__generate__

LOG_LEVEL=info
# false: the bot answers commands, notifications wait in the outbox
NOTIFY_ENABLED=true
# Only these kinds (comma-separated); empty = all
NOTIFY_KINDS=

# Sizing for a 4 vCPU / 8 GB server; halve the memory values on 4 GB.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MEM_LIMIT=3g
API_MEM_LIMIT=1536m
# API processes: auto = one per CPU core
API_PROCESSES=auto
WORKER_MEM_LIMIT=512m
