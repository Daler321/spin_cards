# Compose-level settings. Copied to infra/.env by `make env` (or `make up`).

# Host port of the single entry point (Caddy).
PROXY_PORT=8080

# Caddy site address: ":80" for local HTTP/tunnel, a domain name in production (auto HTTPS).
SITE_ADDRESS=:80

POSTGRES_USER=spincards
POSTGRES_PASSWORD=spincards
POSTGRES_DB=spincards

# ngrok (default tunnel for `make tunnel`): https://dashboard.ngrok.com
# NGROK_AUTHTOKEN — Your Authtoken; NGROK_DOMAIN — your free static domain (Domains page),
# e.g. something.ngrok-free.app. Without NGROK_DOMAIN the URL changes on every start.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# HTTPS address of the Mini App (tunnel URL from `make tunnel` or your domain).
# Also set it in @BotFather as the Mini App URL. Passed to api and bot.
PUBLIC_URL=

# Shared secret of the internal bot -> api routes. `make env` generates it.
INTERNAL_API_TOKEN=__generate__
