# Serves a built SPA inside the web/admin runtime images.
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed build files never change. A missing one is a 404, not the SPA page: an old page asking
	# for a chunk of a previous release must fail loudly (the app then reloads itself).
	@assets path */assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The page itself is revalidated on every open, so a deploy reaches players at once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {$SPA_INDEX:/index.html}
		file_server
	}
}
